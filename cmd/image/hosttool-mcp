#!/usr/bin/env node
"use strict";

const { createConnection } = require("node:net");
const { readFileSync } = require("node:fs");
const { createInterface: readline } = require("node:readline");

const tools = JSON.parse(readFileSync("/opt/sandbox-host-tools.json", "utf8"));
const session = process.env.SANDBOX_SESSION;
const port = parseInt(process.env.SANDBOX_HOSTTOOL_PORT || "9847", 10);
const host = "host.docker.internal";

function send(obj) {
    process.stdout.write(JSON.stringify(obj) + "\n");
}

function buildInputSchema(args) {
    const properties = {};
    const required = [];
    for (const a of args) {
        const type = a.type || "string";
        const prop = { type };
        if (a.description) prop.description = a.description;
        if (a.enum) prop.enum = a.enum;
        if (a.regex) prop.pattern = a.regex;
        if (a.min !== undefined) prop.minimum = a.min;
        if (a.max !== undefined) prop.maximum = a.max;
        if (a.min_length !== undefined) prop.minLength = a.min_length;
        if (a.max_length !== undefined) prop.maxLength = a.max_length;
        if (a.url) {
            prop.format = "uri";
            const bits = [];
            const schemes = a.url.schemes || ["https"];
            bits.push(`scheme: ${schemes.join("|")}`);
            if (a.url.hosts && a.url.hosts.length) {
                bits.push(`host: ${a.url.hosts.join(", ")}`);
            }
            if (a.url.path_prefix) bits.push(`path prefix: ${a.url.path_prefix}`);
            const blockPrivate = a.url.block_private_ips !== false;
            if (blockPrivate) bits.push("private/loopback IPs blocked");
            const note = `URL constraints — ${bits.join("; ")}`;
            prop.description = prop.description ? `${prop.description}. ${note}` : note;
        }
        properties[a.name] = prop;
        const isRequired = a.required === undefined ? true : a.required;
        if (isRequired && a.default === undefined) required.push(a.name);
    }
    const schema = { type: "object", properties };
    if (required.length) schema.required = required;
    return schema;
}

function buildDescription(t) {
    return t.description || `Run host tool: ${t.name}`;
}

function callDaemon(toolName, args) {
    return new Promise((resolve, reject) => {
        const client = createConnection({ host, port }, () => {
            client.write(
                JSON.stringify({
                    type: "execute",
                    session,
                    command: toolName,
                    args,
                }) + "\n",
            );
        });
        let buf = "";
        client.on("data", (chunk) => {
            buf += chunk;
        });
        client.on("end", () => {
            try {
                const resp = JSON.parse(buf.trim());
                resolve(resp);
            } catch (e) {
                reject(new Error("bad response from host daemon"));
            }
        });
        client.on("error", (err) => reject(err));
    });
}

const rl = readline({ input: process.stdin });
rl.on("line", (line) => {
    if (line.trim()) handleMessage(JSON.parse(line));
});

async function handleMessage(msg) {
    const { id, method, params } = msg;

    if (method === "initialize") {
        send({
            jsonrpc: "2.0",
            id,
            result: {
                protocolVersion: "2024-11-05",
                capabilities: { tools: {} },
                serverInfo: { name: "host-tools", version: "1.0.0" },
            },
        });
        return;
    }

    if (method === "notifications/initialized") return;

    if (method === "tools/list") {
        send({
            jsonrpc: "2.0",
            id,
            result: {
                tools: tools.map((t) => ({
                    name: t.name,
                    description: buildDescription(t),
                    inputSchema: buildInputSchema(t.args || []),
                })),
            },
        });
        return;
    }

    if (method === "tools/call") {
        const toolName = params.name;
        const toolArgs = params.arguments || {};
        try {
            const resp = await callDaemon(toolName, toolArgs);
            const isError = resp.exit_code !== 0;
            send({
                jsonrpc: "2.0",
                id,
                result: {
                    content: [
                        {
                            type: "text",
                            text:
                                resp.output ||
                                (isError
                                    ? `Exit code: ${resp.exit_code}`
                                    : "OK"),
                        },
                    ],
                    isError,
                },
            });
        } catch (err) {
            send({
                jsonrpc: "2.0",
                id,
                result: {
                    content: [
                        {
                            type: "text",
                            text: `Failed to call host tool: ${err.message}`,
                        },
                    ],
                    isError: true,
                },
            });
        }
        return;
    }

    send({
        jsonrpc: "2.0",
        id,
        error: { code: -32601, message: `Method not found: ${method}` },
    });
}
